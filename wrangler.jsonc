{
  // Cloudflare Workers config: serves the static files in ./public, no server code.
  "name": "imad-work-with-me",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public"
  },
  // Production address: the custom domain (Cloudflare creates its DNS record and HTTPS certificate)
  "routes": [
    { "pattern": "imadbelattar.dev", "custom_domain": true }
  ],
  // Also keep the old imad-work-with-me.<account>.workers.dev address working
  "workers_dev": true,
  // Each version and branch gets its own preview address (used to review changes before merging)
  "preview_urls": true,
  // Settings for branch previews built by `wrangler preview`; empty = same as production
  "previews": {}
}
