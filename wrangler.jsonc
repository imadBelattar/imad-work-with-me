{
  // Cloudflare Workers config: serves the static files in ./public.
  // A small Worker (worker/index.js) runs only for the reel videos, to answer byte-range requests (iPhone Safari needs them).
  "name": "imad-work-with-me",
  "compatibility_date": "2026-10-16",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only these paths go through the Worker; everything else (and _redirects) is plain static assets
    "run_worker_first": ["/assets/reels/*"]
  },
  // Production address: the custom domain (Cloudflare creates its DNS record and HTTPS certificate)
  "routes": [
    { "pattern": "imadbelattar.dev", "custom_domain": true }
  ],
  // Also keep the old imad-work-with-me.<account>.workers.dev address working
  "workers_dev": true,
  // Each version and branch gets its own preview address (used to review changes before merging)
  "preview_urls": true,
  // Settings for branch previews built by `wrangler preview`; empty = same as production
  "previews": {}
}
